# GEMINI_API_KEY: Required for Gemini AI API calls (Rasho Bhai chat advisor & market valuations).
# In Google AI Studio: Open the Secrets panel and add GEMINI_API_KEY with your key from:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional client-side key alias (synced with GEMINI_API_KEY by default)
VITE_GEMINI_API_KEY=""

# VITE_API_URL: The URL of your deployed cloud Node.js mobile phone scraper endpoint.
# Replace with your live backend URL (e.g., https://your-scraper-app.run.app/api/phones)
# If left as the placeholder, the app safely defaults to the local /api/phones dataset.
VITE_API_URL="https://YOUR_BACKEND_URL_HERE/api/phones"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
